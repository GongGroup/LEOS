 !***********************************************************************
 !> @brief Call to Wannier90 interface
+!> @brief Rewrite the num_wann (and, if present, dis_froz_max) lines of an
+!> existing .win file in place (LEOS per-spin ghost fix: the spin copy
+!> inherits the shared max value and must be lowered to that channel's
+!> occupied manifold, with a matching per-spin frozen window). The rewrite
+!> is all-or-nothing and reports success via OK: wannier90's library mode
+!> takes num_wann from the .win file, so ".win num_wann == library argument"
+!> is a hard invariant - whenever the file cannot be rewritten faithfully
+!> (warm-start projections block whose guiding-centre count is tied to the
+!> shared value; a dis_froz_max line but no valid per-spin window, e.g. a
+!> hand-written window; oversized file; I/O error) the caller must fall back
+!> to the shared num_wann and keep the ghosts for this run.
+ SUBROUTINE MLWF_WIN_SET_NUM_WANN(FNAME,NW,FROZ_MAX,IO,OK)
+    USE base
+    CHARACTER(LEN=*),INTENT(IN) :: FNAME
+    INTEGER,INTENT(IN) :: NW
+    REAL(q),INTENT(IN) :: FROZ_MAX
+    TYPE(in_struct),INTENT(IN) :: IO
+    LOGICAL,INTENT(OUT) :: OK
+    INTEGER,PARAMETER :: MAXLINES=20000, LINELEN=255
+    CHARACTER(LEN=LINELEN), ALLOCATABLE :: LINES(:)
+    CHARACTER(LEN=LINELEN) :: BUF
+    INTEGER :: N, I, IOS
+    LOGICAL :: OVERFLOW, HAS_FROZ
+
+    ! the .win files only exist in the master's working directory; other
+    ! ranks never consume OK (the wannier_run call is IU6-guarded).
+    OK = .TRUE.
+    IF (IO%IU6<0) RETURN
+    OK = .FALSE.
+    ALLOCATE(LINES(MAXLINES))
+    N=0; OVERFLOW=.FALSE.; HAS_FROZ=.FALSE.
+    OPEN(UNIT=99,FILE=FNAME,STATUS='OLD',ACTION='READ',IOSTAT=IOS)
+    IF (IOS/=0) RETURN
+    DO
+       READ(99,'(A)',IOSTAT=IOS) BUF
+       IF (IOS/=0) EXIT
+       IF (N>=MAXLINES) THEN
+          OVERFLOW=.TRUE.; EXIT
+       ENDIF
+       N=N+1; LINES(N)=BUF
+    ENDDO
+    CLOSE(99)
+    IF (OVERFLOW) THEN
+       IF (IO%IU6>=0) WRITE(IO%IU6,'(A)') ' LEOS: '//TRIM(FNAME)// &
+      &   ' exceeds the rewrite buffer - keeping shared num_wann'
+       RETURN
+    ENDIF
+    DO I=1,N
+       IF (INDEX(LINES(I),'begin projections')>0) THEN
+          IF (IO%IU6>=0) WRITE(IO%IU6,'(A)') ' LEOS: warm-start projections present - '// &
+         &   'keeping shared num_wann for '//TRIM(FNAME)
+          RETURN
+       ENDIF
+       IF (INDEX(ADJUSTL(LINES(I)),'dis_froz_max') == 1) HAS_FROZ=.TRUE.
+    ENDDO
+    IF (HAS_FROZ .AND. FROZ_MAX==HUGE(FROZ_MAX)) THEN
+       ! a frozen window exists (e.g. hand-written) but no per-spin value is
+       ! available to keep it consistent with the trimmed num_wann
+       IF (IO%IU6>=0) WRITE(IO%IU6,'(A)') ' LEOS: dis_froz_max present without a '// &
+      &   'per-spin window - keeping shared num_wann for '//TRIM(FNAME)
+       RETURN
+    ENDIF
+    OPEN(UNIT=99,FILE=FNAME,STATUS='REPLACE',ACTION='WRITE')
+    DO I=1,N
+       IF (INDEX(ADJUSTL(LINES(I)),'num_wann') == 1) THEN
+          WRITE(99,'(A,I0)') 'num_wann = ', NW
+       ELSEIF (INDEX(ADJUSTL(LINES(I)),'dis_froz_max') == 1 .AND. &
+      &        FROZ_MAX/=HUGE(FROZ_MAX)) THEN
+          WRITE(99,'(A,F14.7)') 'dis_froz_max =', FROZ_MAX
+       ELSE
+          WRITE(99,'(A)') TRIM(LINES(I))
+       ENDIF
+    ENDDO
+    CLOSE(99)
+    OK = .TRUE.
+ END SUBROUTINE MLWF_WIN_SET_NUM_WANN
+
