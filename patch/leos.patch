+#!/usr/bin/env bash
+set -euo pipefail
+
+# Minimal LEOS regression:
+# - ionic: NaCl (ISPIN=1 and ISPIN=2 non-magnetic)
+# - covalent: CH4, CO2
+# - mixed covalent/ionic: GaAs
+
+VASP_STD="${VASP_STD:-/Users/mastreina/Desktop/EOS4VASP/vasp.6.4.3/bin/vasp_std}"
+POTPAW_TGZ="${POTPAW_TGZ:-/Users/mastreina/Desktop/EOS4VASP/potpaw_PBE.64.tgz}"
+NP="${NP:-4}"
+
+if [[ ! -x "$VASP_STD" ]]; then
+  echo "ERROR: VASP_STD not found/executable: $VASP_STD" >&2
+  exit 2
+fi
+if [[ ! -f "$POTPAW_TGZ" ]]; then
+  echo "ERROR: POTPAW_TGZ not found: $POTPAW_TGZ" >&2
+  exit 2
+fi
+
+check_nelect_wann() {
+  local label="$1"
+  local expected actual
+
+  expected="$(awk 'NR==6{print $1; exit}' EIGENVAL)"
+  actual="$(awk '$1=="#" && $2=="NELECT(Wannier)" {print $4; exit}' EOSCAR)"
+
+  if [[ -z "${expected:-}" || -z "${actual:-}" ]]; then
+    echo "FAILED: $label (missing NELECT/Wannier in EIGENVAL/EOSCAR)" >&2
+    [[ -f EOSCAR ]] && cat EOSCAR >&2
+    exit 1
+  fi
+
+  if awk -v a="$actual" -v b="$expected" -v tol="0.05" 'BEGIN{d=a-b; if(d<0)d=-d; exit(d>tol)}'; then
+    return 0
+  fi
+
+  echo "FAILED: $label NELECT mismatch (NELECT=$expected, NELECT(Wannier)=$actual)" >&2
+  cat EOSCAR >&2
+  exit 1
+}
+
+run_nacl() {
+  local ispin="$1"
+  local work
+  work="$(mktemp -d "/tmp/leos-smoke-nacl-XXXXXX")"
+  trap 'rm -rf "$work"' RETURN
+
+  cd "$work"
+
+  cat > POSCAR <<'EOF'
+NaCl
+5.6402
+0.0 0.5 0.5
+0.5 0.0 0.5
+0.5 0.5 0.0
+Na Cl
+1 1
+Direct
+0 0 0
+0.5 0.5 0.5
+EOF
+
+  cat > KPOINTS <<'EOF'
+Gamma mesh
+0
+Gamma
+4 4 4
+0 0 0
+EOF
+
+  {
+    tar -xOf "$POTPAW_TGZ" Na/POTCAR
+    tar -xOf "$POTPAW_TGZ" Cl/POTCAR
+  } > POTCAR
+
+  {
+    echo "SYSTEM = NaCl LEOS smoke"
+    echo "ENCUT = 300"
+    echo "PREC = Accurate"
+    echo "ISMEAR = 0"
+    echo "SIGMA = 0.05"
+    echo "EDIFF = 1E-6"
+    echo "IBRION = -1"
+    echo "NSW = 0"
+    echo "LWAVE = .FALSE."
+    echo "LCHARG = .FALSE."
+    echo "LEOS = .TRUE."
+    if [[ "$ispin" -eq 2 ]]; then
+      echo "ISPIN = 2"
+      echo "MAGMOM = 0 0"
+    fi
+  } > INCAR
+
+  export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
+  mpirun -np "$NP" "$VASP_STD" > vasp.out 2> vasp.err
+
+  check_nelect_wann "NaCl ISPIN=$ispin"
+
+  local na cl
+  na="$(awk '$2=="Na"{print $6; exit}' EOSCAR)"
+  cl="$(awk '$2=="Cl"{print $6; exit}' EOSCAR)"
+
+  if [[ "$na" != "1" || "$cl" != "-1" ]]; then
+    echo "FAILED: ISPIN=$ispin (Na=$na, Cl=$cl)" >&2
+    cat EOSCAR >&2
+    exit 1
+  fi
+}
+
+run_ch4() {
+  local work
+  work="$(mktemp -d "/tmp/leos-smoke-ch4-XXXXXX")"
+  trap 'rm -rf "$work"' RETURN
+
+  cd "$work"
+
+  cat > POSCAR <<'EOF'
+CH4
+12.0
+1 0 0
+0 1 0
+0 0 1
+C H
+1 4
+Direct
+0.5000 0.5000 0.5000
+0.5700 0.5700 0.5700
+0.4300 0.4300 0.5700
+0.4300 0.5700 0.4300
+0.5700 0.4300 0.4300
+EOF
+
+  cat > KPOINTS <<'EOF'
+Gamma
+0
+Gamma
+1 1 1
+0 0 0
+EOF
+
+  {
+    tar -xOf "$POTPAW_TGZ" C/POTCAR
+    tar -xOf "$POTPAW_TGZ" H/POTCAR
+  } > POTCAR
+
+  cat > INCAR <<'EOF'
+SYSTEM = CH4 LEOS smoke
+ENCUT = 400
+PREC = Accurate
+ISMEAR = 0
+SIGMA = 0.05
+EDIFF = 1E-6
+IBRION = -1
+NSW = 0
+LWAVE = .FALSE.
+LCHARG = .FALSE.
+LEOS = .TRUE.
+EOF
+
+  export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
+  mpirun -np "$NP" "$VASP_STD" > vasp.out 2> vasp.err
+
+  check_nelect_wann "CH4"
+
+  local c h1 h2 h3 h4
+  c="$(awk '$2=="C"{print $6; exit}' EOSCAR)"
+  h1="$(awk '($2=="H"){print $6; exit}' EOSCAR)"
+  h2="$(awk '($2=="H"){c++; if(c==2){print $6; exit}}' EOSCAR)"
+  h3="$(awk '($2=="H"){c++; if(c==3){print $6; exit}}' EOSCAR)"
+  h4="$(awk '($2=="H"){c++; if(c==4){print $6; exit}}' EOSCAR)"
+
+  if [[ "$c" != "-4" || "$h1" != "1" || "$h2" != "1" || "$h3" != "1" || "$h4" != "1" ]]; then
+    echo "FAILED: CH4 (C=$c H=$h1,$h2,$h3,$h4)" >&2
+    cat EOSCAR >&2
+    exit 1
+  fi
+}
+
+run_co2() {
+  local work
+  work="$(mktemp -d "/tmp/leos-smoke-co2-XXXXXX")"
+  trap 'rm -rf "$work"' RETURN
+
+  cd "$work"
+
+  cat > POSCAR <<'EOF'
+CO2
+12.0
+1 0 0
+0 1 0
+0 0 1
+C O
+1 2
+Direct
+0.5000 0.5000 0.5000
+0.5000 0.5000 0.3900
+0.5000 0.5000 0.6100
+EOF
+
+  cat > KPOINTS <<'EOF'
+Gamma
+0
+Gamma
+1 1 1
+0 0 0
+EOF
+
+  {
+    tar -xOf "$POTPAW_TGZ" C/POTCAR
+    tar -xOf "$POTPAW_TGZ" O/POTCAR
+  } > POTCAR
+
+  cat > INCAR <<'EOF'
+SYSTEM = CO2 LEOS smoke
+ENCUT = 400
+PREC = Accurate
+ISMEAR = 0
+SIGMA = 0.05
+EDIFF = 1E-6
+IBRION = -1
+NSW = 0
+LWAVE = .FALSE.
+LCHARG = .FALSE.
+LEOS = .TRUE.
+EOF
+
+  export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
+  mpirun -np "$NP" "$VASP_STD" > vasp.out 2> vasp.err
+
+  check_nelect_wann "CO2"
+
+  local c o1 o2
+  c="$(awk '$2=="C"{print $6; exit}' EOSCAR)"
+  o1="$(awk '($2=="O"){print $6; exit}' EOSCAR)"
+  o2="$(awk '($2=="O"){c++; if(c==2){print $6; exit}}' EOSCAR)"
+
+  if [[ "$c" != "4" || "$o1" != "-2" || "$o2" != "-2" ]]; then
+    echo "FAILED: CO2 (C=$c O=$o1,$o2)" >&2
+    cat EOSCAR >&2
+    exit 1
+  fi
+}
+
+run_gaas() {
+  local work
+  work="$(mktemp -d "/tmp/leos-smoke-gaas-XXXXXX")"
+  trap 'rm -rf "$work"' RETURN
+
+  cd "$work"
+
+  cat > POSCAR <<'EOF'
+GaAs
+5.6533
+0.0 0.5 0.5
+0.5 0.0 0.5
+0.5 0.5 0.0
+Ga As
+1 1
+Direct
+0.0000 0.0000 0.0000
+0.2500 0.2500 0.2500
+EOF
+
+  cat > KPOINTS <<'EOF'
+Gamma mesh
+0
+Gamma
+4 4 4
+0 0 0
+EOF
+
+  {
+    tar -xOf "$POTPAW_TGZ" Ga/POTCAR
+    tar -xOf "$POTPAW_TGZ" As/POTCAR
+  } > POTCAR
+
+  cat > INCAR <<'EOF'
+SYSTEM = GaAs LEOS smoke
+ENCUT = 350
+PREC = Accurate
+ISMEAR = 0
+SIGMA = 0.05
+EDIFF = 1E-6
+IBRION = -1
+NSW = 0
+LWAVE = .FALSE.
+LCHARG = .FALSE.
+LEOS = .TRUE.
+EOF
+
+  export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
+  mpirun -np "$NP" "$VASP_STD" > vasp.out 2> vasp.err
+
+  check_nelect_wann "GaAs"
+
+  local ga as
+  ga="$(awk '$2=="Ga"{print $6; exit}' EOSCAR)"
+  as="$(awk '$2=="As"{print $6; exit}' EOSCAR)"
+
+  if [[ "$ga" != "3" || "$as" != "-3" ]]; then
+    echo "FAILED: GaAs (Ga=$ga As=$as)" >&2
+    cat EOSCAR >&2
+    exit 1
+  fi
+}
+
+cases=("$@")
+if [[ ${#cases[@]} -eq 0 ]]; then
+  cases=(nacl1 nacl2 ch4 co2 gaas)
+fi
+
+for c in "${cases[@]}"; do
+  case "$c" in
+    nacl) run_nacl 1; run_nacl 2 ;;
+    nacl1) run_nacl 1 ;;
+    nacl2) run_nacl 2 ;;
+    ch4) run_ch4 ;;
+    co2) run_co2 ;;
+    gaas) run_gaas ;;
+    *) echo "ERROR: unknown case: $c" >&2; exit 2 ;;
+  esac
+done
+
+echo "OK: LEOS smoke test passed (${cases[*]})"
