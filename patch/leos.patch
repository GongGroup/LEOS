+#!/usr/bin/env bash
+set -euo pipefail
+
+# Broad LEOS tests on metal oxides (variable valence focus).
+#
+# Run inside the Ubuntu VM, e.g.:
+#   orb -m Ubuntu-x64 bash -lc 'bash /Users/mastreina/Desktop/EOS4VASP/leos_oxide_tests.sh'
+#
+# To keep outputs on the shared macOS filesystem for inspection:
+#   orb -m Ubuntu-x64 bash -lc 'WORK_ROOT=/Users/mastreina/Desktop/EOS4VASP/leos_work bash /Users/mastreina/Desktop/EOS4VASP/leos_oxide_tests.sh nio'
+
+VASP_STD="${VASP_STD:-/Users/mastreina/Desktop/EOS4VASP/vasp.6.4.3/bin/vasp_std}"
+POTPAW_TGZ="${POTPAW_TGZ:-/Users/mastreina/Desktop/EOS4VASP/potpaw_PBE.64.tgz}"
+NP="${NP:-4}"
+WORK_ROOT="${WORK_ROOT:-/tmp}"
+
+if [[ ! -x "$VASP_STD" ]]; then
+  echo "ERROR: VASP_STD not found/executable: $VASP_STD" >&2
+  exit 2
+fi
+if [[ ! -f "$POTPAW_TGZ" ]]; then
+  echo "ERROR: POTPAW_TGZ not found: $POTPAW_TGZ" >&2
+  exit 2
+fi
+
+export OMP_NUM_THREADS="${OMP_NUM_THREADS:-1}"
+
+mk_potcar() {
+  : > POTCAR
+  for el in "$@"; do
+    tar -xOf "$POTPAW_TGZ" "$el/POTCAR" >> POTCAR
+  done
+}
+
+nelect_from_eigenval() {
+  awk 'NR==6{print $1; exit}' EIGENVAL
+}
+
+nelect_from_eoscar() {
+  awk '$1=="#" && $2=="NELECT(Wannier)"{print $4; exit}' EOSCAR
+}
+
+check_nelect_wann() {
+  local label="$1"
+  local tol="${2:-0.10}"
+  local expected actual
+
+  expected="$(nelect_from_eigenval)"
+  actual="$(nelect_from_eoscar)"
+  if [[ -z "${expected:-}" || -z "${actual:-}" ]]; then
+    echo "  FAIL: $label (missing NELECT/Wannier in EIGENVAL/EOSCAR)" >&2
+    return 1
+  fi
+
+  if awk -v a="$actual" -v b="$expected" -v tol="$tol" 'BEGIN{d=a-b; if(d<0)d=-d; exit(d>tol)}'; then
+    return 0
+  fi
+
+  echo "  FAIL: $label NELECT mismatch (NELECT=$expected, NELECT(Wannier)=$actual)" >&2
+  return 1
+}
+
+stats_os_int() {
+  # prints: avg min max count
+  local el="$1"
+  awk -v el="$el" '
+    $1 ~ /^[0-9]+$/ && $2==el {x=$6; s+=x; c+=1; if(!init||x<mn)mn=x; if(!init||x>mx)mx=x; init=1}
+    END{if(c==0){print "nan nan nan 0"} else {printf "%.6f %.0f %.0f %d\n", s/c, mn, mx, c}}
+  ' EOSCAR
+}
+
+run_vasp() {
+  mpirun -np "$NP" "$VASP_STD" > vasp.out 2> vasp.err
+}
+
+run_case() {
+  local name="$1"
+  shift
+
+  mkdir -p "$WORK_ROOT"
+  local work
+  work="$(mktemp -d "${WORK_ROOT%/}/leos-oxide-${name}-XXXXXX")"
+  echo ""
+  echo "== $name =="
+  echo "  workdir: $work"
+  local t0=$SECONDS
+
+  ( cd "$work" && "$@" )
+  local rc=$?
+  local dt=$((SECONDS - t0))
+  echo "  time: ${dt}s"
+  return "$rc"
+}
+
+case_tio2() {
+  # Rutile TiO2 (expected: Ti +4, O -2)
+  cp /Users/mastreina/Desktop/EOS4VASP/vasp.6.4.3/testsuite/tests/TiO2_PRECFOCK=NORMAL/POSCAR POSCAR
+  cat > KPOINTS <<'EOF'
+Gamma mesh
+0
+Gamma
+1 1 1
+0 0 0
+EOF
+  mk_potcar Ti O
+  cat > INCAR <<'EOF'
+SYSTEM = TiO2 LEOS oxide test
+ENCUT = 400
+PREC = Normal
+ISMEAR = 0
+SIGMA = 0.05
+EDIFF = 1E-6
+IBRION = -1
+NSW = 0
+LWAVE = .FALSE.
+LCHARG = .FALSE.
+LEOS = .TRUE.
+EOF
+  run_vasp
+
+  check_nelect_wann "TiO2" || return 1
+
+  local ti o
+  ti="$(stats_os_int Ti)"
+  o="$(stats_os_int O)"
+  echo "  Ti OS(int): $ti"
+  echo "   O OS(int): $o"
+
+  [[ "$(awk '{print $1}' <<<"$ti")" == "4.000000" ]] || return 1
+  [[ "$(awk '{print $2,$3}' <<<"$o")" == "-2 -2" ]] || return 1
+}
