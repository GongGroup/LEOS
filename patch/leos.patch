+all_cases=(tio2 sno sno2 cu2o cuo mno mno2 nio feo coo lafeo3 lavo3 laco3 ceo2 ce2o3 nareo4 re2 recl4)
+
+cases=("$@")
+if [[ ${#cases[@]} -eq 0 ]]; then
+  cases=("${all_cases[@]}")
+fi
+
+fail=0
+total="${#cases[@]}"
+done=0
+t_all0=$SECONDS
+
+for c in "${cases[@]}"; do
+  done=$((done + 1))
+  if run_case "$c" "case_${c}"; then
+    echo "  PASS: $c"
+  else
+    echo "  FAIL: $c" >&2
+    fail=$((fail + 1))
+  fi
+
+  elapsed=$((SECONDS - t_all0))
+  if [[ $done -gt 0 ]]; then
+    eta=$(( (total - done) * elapsed / done ))
+  else
+    eta=0
+  fi
+  echo "  progress: ${done}/${total}  elapsed: ${elapsed}s  est_remaining: ${eta}s"
+done
+
+echo ""
+echo "Done: total=$total, fail=$fail"
+if [[ $fail -ne 0 ]]; then
+  exit 1
+fi
