# Virtual environment
.venv/
__pycache__/
# macOS
.DS_Store
# reference PDFs (copyrighted, not tracked)
docs/refs/*.pdf

# --- job data guard: raw VASP/wannier90/MD outputs stay on the cluster ---
# Harvest convention (v3+): only EOSCAR / INCAR / POSCAR / CONTCAR / KPOINTS /
# *.win / *.wout / summary tsv+json go into git. Rules below only block NEW
# files; v1-era files already tracked are unaffected. Override: git add -f.
WAVECAR*
CHGCAR*
CHG
PROCAR*
LOCPOT
ELFCAR
AECCAR*
DOSCAR*
EIGENVAL*
IBZKPT
XDATCAR*
OUTCAR*
vasprun.xml
vaspout.h5
REPORT
PCDAT
ML_AB*
ML_FF*
# licensed pseudopotentials — never commit new copies
POTCAR*
# wannier90 binary / intermediate files
*.chk
*.amn
*.mmn
*.spn
*.eig
UNK*
# gpuw90 gold-standard test inputs are text-sized and must stay in git
!gpuw90/testdata/**
# ...but the whitelist above un-ignores .DS_Store too; re-ignore it
gpuw90/testdata/**/.DS_Store
# ...except the entangled gold-set raw inputs (issue #14): 10-300 MB each.
# Small .win/.eig/*_ref.wout stay tracked; refetch the big ones from sai-pod
# via gpuw90/testdata/fetch_entangled.sh
gpuw90/testdata/li2mno3/*.mmn
gpuw90/testdata/li2mno3/*.amn
gpuw90/testdata/vircef/*.mmn
gpuw90/testdata/vircef/*.amn
# MD trajectories
*.extxyz
docs/refs/*
!docs/refs/.gitkeep
